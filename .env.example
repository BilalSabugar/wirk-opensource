# ─── Firebase Config ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your Firebase project values.
# Get these from: Firebase Console → Project Settings → Your Apps → SDK setup
# NEVER commit your actual .env file to git.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Gemini AI Config ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_SECONDARY=your_optional_secondary_gemini_api_key_here

# ─── Encryption Config ────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
# REQUIRED in production — app will reject requests if missing.
ENCRYPTION_SECRET=generate_a_random_32_plus_char_string_here